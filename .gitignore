# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
# large local media
/public/*.mp4
/public/*.mov

# source videos (never commit)
private_videos/
public/*.mp4

# keep optimized deploy videos
!public/videos/*.mp4

# stray source media at repo root (ngbcHero.mov alone is ~291MB)
/*.mp4
/*.mov

# MCP browser-test artifacts
.playwright-mcp/

# Ingestion source caches: large government downloads, re-fetched by their builder.
.cache/

# Next's managed agent-rules block. `next dev` appends it to an agent file; with
# no AGENTS.md present it appends to CLAUDE.md, which §65 reserves for the owner.
# scripts/ensure-agents-md.mjs creates this file as `predev` so the block lands
# here instead. Generated per checkout, so it is not tracked.
AGENTS.md
