        "habitat": [
          {
            "text": "Ruffed grouse use a mixture of early, middle and mature forest stages. In northern parts of the range, aspen stands of different ages commonly provide this structure; dense shrub or small-tree cover is important through the year.",
            "sourceIds": [
              "source:usfs-ruffed-grouse-review"
            ]
          }
        ],
        "seasonalBehavior": [
          {
            "text": "Habitat use and food change through the year. In northern forests, buds and twigs become important from fall through spring, while conifers can provide winter shelter.",
