  "blocks": [
    {
      "id": "content_block:ruffed-grouse.quick-answer.01",
      "ownerId": "species:ruffed-grouse",
      "type": "quick_answer",
      "locale": "en-CA",
      "status": "published",
      "content": {
        "plainText": "Ruffed grouse are resident forest grouse associated with mixed-age hardwood and mixed-wood cover. A species identity never establishes that hunting is open; resolve the management unit and date against current official rules."
      },
      "applicability": {
        "speciesIds": [
          "species:ruffed-grouse"
        ],
        "activityIds": [
          "activity:hunting"
        ]
      },
      "priority": 90,
