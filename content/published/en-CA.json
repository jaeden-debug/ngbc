    },
    {
      "id": "content_block:ruffed-grouse.habitat.01",
      "ownerId": "species:ruffed-grouse",
      "type": "habitat_tip",
      "locale": "en-CA",
      "status": "published",
      "content": {
        "plainText": "Look for connected forest containing several age classes: dense young hardwood cover near older trees and a developed shrub layer. In northern parts of the range, aspen often supplies this structure."
      },
      "applicability": {
        "speciesIds": [
