    {
      "id": "content_block:ruffed-grouse.identification.01",
      "ownerId": "species:ruffed-grouse",
      "type": "identification_warning",
      "locale": "en-CA",
      "status": "published",
      "content": {
        "plainText": "Do not resolve “partridge” directly to ruffed grouse. That regional name is ambiguous, and Ontario's grouse rules differ among WMU groups. Confirm the species and the applicable row in the current official table."
      },
      "applicability": {
