  "legalTimeNotice": {
    "page": 14,
    "statedAs": "Manitoba now observes permanent daylight saving time. Sunrise and sunset information available through the National Research Council Canada website may not reflect this change. Hunters should be aware of any differences when determining legal hunting hours.",
    "addedIn": "the 25 September 2026 reissue",
    "whyItIsHere": "The only substantive change between the two editions, and it is about the one thing a reader of this guide most needs to get right. North Ground was making exactly the error the province warns about: hunting-hours clocks were an hour early from 1 November until the override in observed-clock.ts. Kept as a crosscheck fact so a future edition dropping or altering it is visible.",
    "northGroundHandling": "The instrument is The Official Time Amendment Act, S.M. 2023, c. 4, amending The Official Time Act, C.C.S.M. c. O30, in force 31 October 2026 by proclamation signed 23 September 2026. See JURISDICTION_TIME_BASIS and OBSERVED_CLOCK_OVERRIDES."
  },
  "residencyClasses": {
    "page": 7,
    "MANITOBA_RESIDENT": "A person whose primary residence is in Manitoba and who has lived in Manitoba for at least six consecutive months during the 12-month period immediately before the person applies for a licence of permit under this act.",
    "CANADIAN_RESIDENT": "A person other than a Manitoba resident, who is a Canadian citizen, a permanent resident within the meaning of the Immigration and Refugee Protection Act (Canada), or a person whose primary residence is in Canada and who has lived in Canada for at least six consecutive months during the 12-month period immediately before the person applies for a licence or permit under this Act.",
    "NON_CANADIAN_RESIDENT": "A person who is not a Manitoba resident or a Canadian resident."
  },
