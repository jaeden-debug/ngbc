{
  "bundleId": "ca-pe-2026",
  "jurisdictionId": "jurisdiction:ca-pe",
  "sourceVersion": "Hunting and Trapping Seasons Regulations (EC592/16), consolidated to September 3, 2022 (last amendment EC654/22)",
  "retrievedAt": "2026-10-29",
  "geographyScope": {
    "kind": "WHOLE_JURISDICTION",
    "statedAs": "Prince Edward Island (Schedule I states no area)",
    "resolvedBy": "layer:ca-pe-province",
    "why": "Prince Edward Island publishes no hunting units and its seasons regulation names none, so each rule's geography is the province. A point reaches these rules through the province layer, served at geography level JURISDICTION with no zone id."
  },
  "editionCurrency": {
    "checkedAt": "2026-10-29",
    "statedAs": "The Legislative Counsel Office's consolidation published on 2026-10-29 is current to September 3, 2022, and its amendment history ends at EC654/22. The province's 2025 Hunting Summary agrees with it on every species, date and limit."
  },
  "certifiedPeriod": {
    "from": "2025-04-01",
    "to": "2027-03-31",
    "reason": "Schedule I is a standing rule stated by month and day, so this period is North Ground's declared derivation span: the 2025–26 and 2026–27 seasons. The 2025 summary confirms the first; an amendment made since the September 2022 consolidation would not be reflected."
  },
  "absence": {
    "meaning": "UNKNOWN",
    "section": "Hunting and Trapping Seasons Regulations, Schedule I",
    "sourceId": "source:ca-pe-hunting-trapping-seasons-regulations",
    "explanation": "Every rule in this bundle reaches the whole province, so a place no rule reaches is outside Prince Edward Island or inside an exception, and that says nothing about whether a season is open there."
  },
  "specialGeographies": [
    {
      "id": "special_geography:ca-pe-lots-1-10-43-47",
      "name": "Lots 1 to 10 and Lots 43 to 47",
      "statedAs": "Lots 1 to 10 and Lots 43 to 47 of Prince Edward Island",
      "resolution": "UNRESOLVED",
      "withinJurisdiction": "jurisdiction:ca-pe",
      "reason": "Section 1(2) of the seasons regulation names these Lots (the province's historic townships), and North Ground holds no boundary for them that it can test, so it cannot say whether this point lies inside them.",
      "sourceId": "source:ca-pe-hunting-trapping-seasons-regulations"
    }
  ],
