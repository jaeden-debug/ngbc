{"objectIdFieldName":"OBJECTID","uniqueIdField":{"name":"OBJECTID","isSystemMaintained":true},"globalIdFieldName":"","geometryType":"esriGeometryPolygon","spatialReference":{"wkid":102100,"latestWkid":3857},"fields":[{"name":"OBJECTID","type":"esriFieldTypeOID","alias":"FID","sqlType":"sqlTypeOther","domain":null,"defaultValue":null,"required":true},{"name":"Name","type":"esriFieldTypeString","alias":"Name","sqlType":"sqlTypeOther","length":254,"domain":null,"defaultValue":null},{"name":"Restric","type":"esriFieldTypeString","alias":"Restrictions","sqlType":"sqlTypeOther","length":1000,"domain":null,"defaultValue":null,"required":true},{"name":"Reg","type":"esriFieldTypeString","alias":"Regulation","sqlType":"sqlTypeOther","length":254,"domain":null,"defaultValue":null}],"features":[{"attributes":{"OBJECTID":1,"Name":"Ralls Island","Restric":"No person shall hunt with a rifle requiring a centrefire cartridge","Reg":"The Wildlife Act (C.C.S.M. c. W130), General Hunting Regulation (351/87)"}},{"attributes":{"OBJECTID":2,"Name":"Parks Creek Drain","Restric":"No person shall hunt or kill an upland game bird, a wild turkey, a migratory game bird, or a big game animal","Reg":"The Wildlife Act (C.C.S.M. c. W130), General Hunting Regulation (351/87)"}},{"attributes":{"OBJECTID":3,"Name":"Deer Island","Restric":"No person shall hunt or kill a moose","Reg":"The Wildlife Act (C.C.S.M. c. W130), General Hunting Regulation (351/87)"}},{"attributes":{"OBJECTID":4,"Name":"Hecla Island","Restric":"No person shall hunt or kill a moose, a black bear, or a deer","Reg":"The Wildlife Act (C.C.S.M. c. W130), General Hunting Regulation (351/87)"}},{"attributes":{"OBJECTID":5,"Name":"Portion of GHA 38 and City of Winnipeg","Restric":"No person shall hunt or kill wildlife","Reg":"The Wildlife Act (C.C.S.M. c. W130), General Hunting Regulation (351/87)"}},{"attributes":{"OBJECTID":6,"Name":"Portion of Pembina Valley Provincial Park","Restric":"No person shall hunt, trap, shoot or kill an upland game bird, a wild turkey, a migratory game bird, a big game animal, or a fur bearing animal","Reg":"The Wildlife Act (C.C.S.M. c. W130), General Hunting Regulation (351/87) and Trapping of Wild Animals Regulation (245/90)"}},{"attributes":{"OBJECTID":7,"Name":"GHA 4 Moose Conservation Area","Restric":"No person shall hunt or kill a moose","Reg":"The Wildlife Act (C.C.S.M. c. W130), General Hunting Regulation (351/87)"}},{"attributes":{"OBJECTID":8,"Name":"Rocky Lake Restricted Hunting Area","Restric":"No person shall hunt or kill wildlife, except a furbearing animal or gray (timber) wolf by trapping","Reg":"The Wildlife Act (C.C.S.M. c. W130), General Hunting Regulation (351/87)"}},{"attributes":{"OBJECTID":9,"Name":"RM of MacDonald Firearms Discharge Restricted Area","Restric":"No person shall discharge a firearm or bow while hunting migratory game birds or deer","Reg":"The Wildlife Act (C.C.S.M. c. W130), General Hunting Regulation (351/87)"}},{"attributes":{"OBJECTID":10,"Name":"RM of Rosser Firearms Discharge Restricted Area","Restric":"No person shall discharge a firearm or bow while hunting migratory game birds","Reg":"The Wildlife Act (C.C.S.M. c. W130), General Hunting Regulation (351/87)"}},{"attributes":{"OBJECTID":11,"Name":"GHA 2A and 7 Moose Conservation Area","Restric":"No person shall hunt or kill a moose","Reg":"The Wildlife Act (C.C.S.M. c. W130), General Hunting Regulation (351/87)"}},{"attributes":{"OBJECTID":12,"Name":"Turtle Mountain Community Pasture","Restric":"Area is excluded from the GHA 29 and 29A fall draw general (rifle) elk season","Reg":"The Wildlife Act (C.C.S.M. c. W130), Hunting Seasons and Bag Limits Regulation (165/91)"}},{"attributes":{"OBJECTID":13,"Name":"GHA 14 Swan-Pelican Provincial Forest Area","Restric":"No licenced elk hunting. Resident Draw Elk licences may only be used in the portions of GHA 14 west of Swan-Pelican Provincial Forest and south of Dawson Bay on Lake Winnipegosis","Reg":"The Wildlife Act (C.C.S.M. c. W130), Hunting Seasons and Bag Limits Regulation (165/91)"}},{"attributes":{"OBJECTID":14,"Name":"RM of MacDonald Firearms Discharge Restricted Area","Restric":"No person shall discharge a firearm or bow while hunting migratory game birds or deer","Reg":"The Wildlife Act (C.C.S.M. c. W130), General Hunting Regulation (351/87)"}},{"attributes":{"OBJECTID":15,"Name":"Portion of GHA 38 in RM of Rosser","Restric":"No person shall hunt, trap, shoot, or kill an upland game bird, a wild turkey, a fur bearing animal, or a big game animal","Reg":"The Wildlife Act (C.C.S.M. c. W130), General Hunting Regulation (351/87) and Trapping of Wild Animals Regulation (245/90)"}},{"attributes":{"OBJECTID":17,"Name":"Portion of GHA 38 in RM of MacDonald","Restric":"No person shall hunt, trap, shoot, or kill an upland game bird, a wild turkey, a fur bearing animal, or a big game animal other than white-tailed deer","Reg":"The Wildlife Act (C.C.S.M. c. W130), General Hunting Regulation (351/87) and Trapping of Wild Animals Regulation (245/90)"}},{"attributes":{"OBJECTID":19,"Name":"Portion of GHA 38 in RM of MacDonald","Restric":"No person shall hunt, trap, shoot, or kill an upland game bird, a wild turkey, a fur bearing animal, or a big game animal other than white-tailed deer","Reg":"The Wildlife Act (C.C.S.M. c. W130), General Hunting Regulation (351/87) and Trapping of Wild Animals Regulation (245/90)"}},{"attributes":{"OBJECTID":22,"Name":"Riding Mountain National Park","Restric":"National Parks have special regulations and guidelines for transporting firearms, using off-road vehicles (ORVs), hunting, and retrieving wounded animals. For more information, contact the local federal Park Canada Agency office. No person shall hunt or kill an upland game bird, a wild turkey, a migratory bird, or a big game animal in Riding Mountain National Park, as per the Manitoba Wildlife Act.","Reg":"The Wildlife Act (C.C.S.M. c. W130), General Hunting Regulation (351/87)"}},{"attributes":{"OBJECTID":24,"Name":"Wapusk National Park","Restric":"National Parks have special regulations and guidelines for transporting firearms, using off-road vehicles (ORVs), hunting, and retrieving wounded animals. For more information, contact the local federal Park Canada Agency office. No person shall hunt or kill wildlife in Wapusk National Park without first obtaining written authority from the Park Superintendent, as per the Manitoba Wildlife Act.","Reg":"The Wildlife Act (C.C.S.M. c. W130), General Hunting Regulation (351/87)"}},{"attributes":{"OBJECTID":25,"Name":"Birds Hill Provincial Park","Restric":"No person shall hunt, trap, shoot, or kill an upland game bird, a wild turkey, a migratory bird, a furbearing animal, or a big game animal within Birds Hill Provincial Park, as per the Manitoba Wildlife Act.","Reg":"The Wildlife Act (C.C.S.M. c. W130), General Hunting Regulation (351/87), Trapping of Wild Animals Regulation (245/90)"}},{"attributes":{"OBJECTID":26,"Name":"Beaudry Provincial Park","Restric":"No person shall hunt, trap, shoot, or kill an upland game bird, a wild turkey, a migratory bird, a furbearing animal, or a big game animal within Beaudry Provincial Park, as per the Manitoba Wildlife Act.","Reg":"The Wildlife Act (C.C.S.M. c. W130), General Hunting Regulation (351/87), Trapping of Wild Animals Regulation (245/90)"}},{"attributes":{"OBJECTID":27,"Name":"Canadian Forces Base Shilo","Restric":"Canadian Forces Base Shilo is closed to all hunting. CFB Shilo is excluded from waterfowl, upland game bird, wild turkey, elk, and black bear hunting seasons in GHA 30, as per the Manitoba Wildlife Act.","Reg":"The Wildlife Act (C.C.S.M. c. W130), Hunting Seasons and Bag Limits Regulation (165/91)"}},{"attributes":{"OBJECTID":33,"Name":"GHA 9A Prohibited Moose Hunting Zone ","Restric":"Area is excluded from the GHA 9A fall archery and draw general (rifle) moose season","Reg":"The Wildlife Act (C.C.S.M. c. W130), Hunting Seasons and Bag Limits Regulation (165/91)"}},{"attributes":{"OBJECTID":34,"Name":"GHA 10 Prohibited Moose Hunting Zone ","Restric":"Area is excluded from the GHA 10 fall archery and draw general (rifle) moose season","Reg":"The Wildlife Act (C.C.S.M. c. W130), Hunting Seasons and Bag Limits Regulation (165/91)"}}]}