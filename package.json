{
  "name": "ngbc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "validate:content": "node scripts/validate-content-contract.mjs --mode=warn fixtures/content-contract/valid-bundle.json",
    "validate:content:strict": "node scripts/validate-content-contract.mjs --strict",
    "validate:content:published": "node scripts/validate-content-contract.mjs --strict content/published/en-CA.json content/published/species-wave-1.json",
    "test:content-contract": "node --test scripts/validate-content-contract.test.mjs",
    "test:content-repository": "node --test src/lib/content/repository.test.ts",
    "test:hunt": "node --test src/lib/hunt/*.test.ts src/lib/hunt/regulatory/*.test.ts",
    "test:newsletter": "node --test src/lib/newsletter/*.test.ts",
    "test:seo": "node --test src/lib/seo/*.test.ts",
    "validate:seo": "node scripts/validate-seo.mjs",
    "test:content-urls": "node --test src/lib/content/*.test.ts",
    "test:hunt-share": "node --require ./scripts/css-module-test-register.cjs --import tsx --test src/lib/hunt-share/*.test.ts src/components/hunt-share/*.test.tsx",
    "certify:supabase": "bash scripts/certify-supabase-local.sh",
    "ingest:zones": "node scripts/ingest-zone-layer.mjs",
    "build:regulations": "node scripts/build-ontario-regulations.mjs && node scripts/build-ontario-major-game.mjs",
    "check:regulatory-sources": "node scripts/build-ontario-regulations.mjs --check && node scripts/build-ontario-major-game.mjs --check",
    "certify:spatial": "node scripts/certify-ontario-spatial-parity.mjs",
    "test:regulatory-sources": "node --test scripts/ontario-source.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/google.maps": "^3.66.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
