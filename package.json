{
  "name": "ngbc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "validate:content": "node scripts/validate-content-contract.mjs --mode=warn fixtures/content-contract/valid-bundle.json",
    "validate:content:strict": "node scripts/validate-content-contract.mjs --strict",
    "validate:content:published": "node scripts/validate-content-contract.mjs --strict content/published/en-CA.json",
    "test:content-contract": "node --test scripts/validate-content-contract.test.mjs",
    "test:content-repository": "node --test src/lib/content/repository.test.ts",
    "test:hunt": "node --test src/lib/hunt/*.test.ts",
    "test:newsletter": "node --test src/lib/newsletter/*.test.ts",
    "test:seo": "node --test src/lib/seo/*.test.ts",
    "validate:seo": "node scripts/validate-seo.mjs",
    "test:content-urls": "node --test src/lib/content/*.test.ts"
  },
  "dependencies": {
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
