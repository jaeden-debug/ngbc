# Canonical public origin used by metadata, robots, sitemap, and origin checks.
NEXT_PUBLIC_SITE_URL=https://www.northgroundbushcraft.com

# ─────────────────────────────────────────────────────────────────────────────
# Supabase — Hunt spatial registry and Hunt Brief persistence
# ─────────────────────────────────────────────────────────────────────────────
# Supabase is the production database, PostGIS host and Hunt Brief store. It is
# NOT a regulatory authority: government sources remain the authority, and
# Supabase only stores records that already carry their official provenance.
#
# Both variables are SERVER ONLY. The service-role key bypasses row level
# security and must never be exposed to the browser or prefixed NEXT_PUBLIC_.
#
# Project Settings → API:
#   SUPABASE_URL              = Project URL
#   SUPABASE_SERVICE_ROLE_KEY = service_role secret (not the anon/publishable key)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_secret

# Apply supabase/migrations/* before enabling Supabase-backed features:
#   supabase link --project-ref <ref>
#   supabase db push
# Then re-run the same assertions the repository certifies locally:
#   npm run certify:supabase

# Which provider resolves a coordinate to an official management zone.
#   supabase      — PostGIS registry (production; requires the variables above)
#   official-gis  — live Ontario LIO feature service (default; no configuration)
SPATIAL_PROVIDER=official-gis
# Fall back to the live official service if Supabase is unreachable. Set to
# `official-gis` to enable. A fallback may only change availability, never the
# regulatory answer.
SPATIAL_FALLBACK_PROVIDER=

# ─────────────────────────────────────────────────────────────────────────────
# Google Maps Platform — consumer location, basemap and weather
# ─────────────────────────────────────────────────────────────────────────────
# Google supplies place discovery, address resolution, the consumer basemap and
# environmental weather context. Google is NOT a hunting-zone, regulatory or
# land-access authority.
#
# Two separate keys, because they need opposite restrictions. Do not reuse one
# unrestricted key for both.
#
# 1) Browser key — shipped to the client, so it must be referrer-restricted.
#    APIs to enable: Maps JavaScript API, Places API (New)
#    Application restriction: HTTP referrers
#      https://www.northgroundbushcraft.com/*
#      https://*.vercel.app/*        (preview deployments)
#      http://localhost:3000/*       (local development)
#    API restriction: Maps JavaScript API, Places API (New)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# 2) Server key — never sent to the browser, so restrict it by IP or leave
#    unrestricted-but-secret and rotate it. Referrer restrictions do not apply
#    to server-to-server calls and will break them.
#    APIs to enable: Places API (New), Geocoding API, Weather API
#    API restriction: Places API (New), Geocoding API, Weather API
GOOGLE_MAPS_SERVER_API_KEY=

# Which provider resolves a typed place or a coordinate to a human place name.
#   google    — Places (New) + Geocoding (production; requires the server key)
#   nominatim — OpenStreetMap Nominatim (default; keyless, rate limited)
GEOCODING_PROVIDER=nominatim

# Which provider supplies environmental weather context.
#   google     — Google Weather API, 10-day horizon (requires the server key)
#   open-meteo — Open-Meteo, 16-day horizon (default; keyless)
WEATHER_PROVIDER=open-meteo
# Fall back to Open-Meteo when Google Weather errors. Set to `open-meteo` to
# enable. Weather is environmental context only and never determines legality.
WEATHER_FALLBACK_PROVIDER=

# Contact address sent with Nominatim requests, as its usage policy requires.
# Only used when GEOCODING_PROVIDER=nominatim.
GEOCODING_CONTACT_EMAIL=contact@northgroundbushcraft.com

# ─────────────────────────────────────────────────────────────────────────────
# Newsletter
# ─────────────────────────────────────────────────────────────────────────────
# Resend Contacts API credentials for durable newsletter subscriptions.
# Create a full-access key at https://resend.com/api-keys (sending-only keys
# cannot manage Contacts), then create/copy a newsletter Segment ID in Resend.
RESEND_API_KEY=re_replace_with_full_access_key
RESEND_SEGMENT_ID=00000000-0000-0000-0000-000000000000

# ─────────────────────────────────────────────────────────────────────────────
# Hunt Brief sharing
# ─────────────────────────────────────────────────────────────────────────────
# Used only to HMAC client network identifiers for distributed share-creation
# rate limiting. Generate an independent secret, e.g. `openssl rand -base64 32`.
HUNT_SHARE_RATE_LIMIT_SECRET=replace_with_random_secret

# ─────────────────────────────────────────────────────────────────────────────
# Local development only
# ─────────────────────────────────────────────────────────────────────────────
# `npm run certify:supabase` applies supabase/migrations/* to a throwaway
# database and asserts PostGIS resolution, rate limiting, immutability and RLS.
# It defaults to this container:
#   docker run -d --name ngbc-hunt-postgis \
#     -e POSTGRES_PASSWORD=postgres -e POSTGRES_USER=postgres -e POSTGRES_DB=postgres \
#     -p 54329:5432 postgis/postgis:16-3.4
SUPABASE_PROBE_ADMIN_URL=
